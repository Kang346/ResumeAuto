# User data — never commit anything in here
user_data/*
!user_data/.gitkeep

# Generated artifacts
output/
work/
logs/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# LaTeX intermediates (in case something gets generated outside work/)
*.aux
*.log
*.out
*.synctex.gz

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
